# Copy this file to .env and fill in ONE AI option. Leave all blank to run with no AI.
# The key stays on the server. It is never sent to the browser.

# Option 1: Google Gemini free tier (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Check the current free model name in Google AI Studio before you pick one.
GEMINI_MODEL=gemini-3-flash-preview

# Option 2: DeepSeek, Z.ai or any OpenAI-style API
# AI_API_KEY=
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat

# Optional: a PIN for the /staff page. Leave blank for no PIN (the tester needs /staff open).
STAFF_PIN=

PORT=3000
